{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jrosenberg",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Muss auf den Angular-Build zeigen, nicht auf dist/ - sonst liegt die
    // Seite unter /jrosenberg/browser/ statt unter /.
    "directory": "dist/jrosenberg/browser",
    // Unbekannte Pfade liefern die 404.html aus (die Angular-Shell rendert
    // darin die Not-Found-Seite) - mit korrektem 404-Status.
    "not_found_handling": "404-page"
  }
}
